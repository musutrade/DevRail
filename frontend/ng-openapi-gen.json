{
  "$schema": "node_modules/ng-openapi-gen/ng-openapi-gen-schema.json",
  "input": "../docs/openapi.json",
  "output": "src/app/generated/api",
  "apiService": "Api",
  "excludeParameters": ["X-CSRF-Token"],
  "promises": true,
  "services": false,
  "enumStyle": "alias",
  "enumArray": false,
  "ignoreUnusedModels": false,
  "indexFile": false,
  "skipJsonSuffix": true,
  "endOfLineStyle": "lf"
}
