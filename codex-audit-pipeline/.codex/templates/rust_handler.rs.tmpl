// 使用前替换: {{ENTITY_NAME}}, {{entity_name}}, {{PERMISSION_MODULE}},
//              {{READ_PERMISSION_TYPE}}, {{WRITE_PERMISSION_TYPE}}
// 注意: Handler 层禁止 SQL（audit 拦截），只允许调用 services
// 风格与 backend/src/handlers/*.rs 一致：
//   axum + State<AppState> + RequirePermission（后端授权是最终安全边界）
// 参考实现: backend/src/handlers/users.rs
use crate::auth::RequirePermission;
use crate::error::ApiError;
use crate::models::{
    {{ENTITY_NAME}}CreateRequest, {{ENTITY_NAME}}Response, Page{{ENTITY_NAME}}, PageQuery,
};
use crate::permissions::{{PERMISSION_MODULE}}::{{{READ_PERMISSION_TYPE}}, {{WRITE_PERMISSION_TYPE}}};
use crate::services;
use crate::AppState;
use axum::extract::{Path, Query, State};
use axum::http::StatusCode;
use axum::Json;

pub async fn list(
    State(state): State<AppState>,
    auth: RequirePermission<{{READ_PERMISSION_TYPE}}>,
    Query(query): Query<PageQuery>,
) -> Result<Json<Page{{ENTITY_NAME}}>, ApiError> {
    services::{{entity_name}}::list(&state.pool, &auth, &query)
        .await
        .map(Json)
}

pub async fn get(
    State(state): State<AppState>,
    auth: RequirePermission<{{READ_PERMISSION_TYPE}}>,
    Path(id): Path<i64>,
) -> Result<Json<{{ENTITY_NAME}}Response>, ApiError> {
    services::{{entity_name}}::get(&state.pool, &auth, id)
        .await
        .map(Json)
}

pub async fn create(
    State(state): State<AppState>,
    auth: RequirePermission<{{WRITE_PERMISSION_TYPE}}>,
    Json(req): Json<{{ENTITY_NAME}}CreateRequest>,
) -> Result<(StatusCode, Json<{{ENTITY_NAME}}Response>), ApiError> {
    services::{{entity_name}}::create(&state.pool, &auth, &req)
        .await
        .map(|data| (StatusCode::CREATED, Json(data)))
}

pub async fn delete(
    State(state): State<AppState>,
    auth: RequirePermission<{{WRITE_PERMISSION_TYPE}}>,
    Path(id): Path<i64>,
) -> Result<StatusCode, ApiError> {
    services::{{entity_name}}::delete(&state.pool, &auth, id).await?;
    Ok(StatusCode::NO_CONTENT)
}
