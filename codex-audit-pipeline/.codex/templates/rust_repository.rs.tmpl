// 使用前替换: {{ENTITY_NAME}}, {{TABLE_NAME}}, {{COLUMN_LIST}},
//              {{VALUE_PLACEHOLDER}}，并用 BIND_FIELDS 替换下方绑定表达式。
// 注意: Repository 层是唯一允许 SQL 写操作的地方（audit allowlist）
// 风格与 backend/src/repositories/*.rs 一致：
//   自由函数 + &PgPool，返回 sqlx::Error（由 Service 层映射为 ApiError）
// 参考实现: backend/src/repositories/users.rs
use crate::access::ActorContext;
use crate::models::{{ENTITY_NAME}}Row;
use sqlx::{AssertSqlSafe, PgConnection, PgPool, Row};

const ENTITY_COLUMNS: &str =
    "id, organization_id, department_id, owner_user_id, {{COLUMN_LIST}}, created_at, updated_at";

pub async fn find_by_id(
    pool: &PgPool,
    actor: &ActorContext,
    id: i64,
) -> Result<Option<{{ENTITY_NAME}}Row>, sqlx::Error> {
    sqlx::query_as::<_, {{ENTITY_NAME}}Row>(AssertSqlSafe(format!(
        "WITH RECURSIVE visible_departments AS (
             SELECT id FROM departments WHERE id = $4 AND organization_id = $2
             UNION
             SELECT child.id FROM departments child
             JOIN visible_departments parent ON child.parent_id = parent.id
             WHERE child.organization_id = $2
         )
         SELECT {ENTITY_COLUMNS} FROM {{TABLE_NAME}}
         WHERE id = $5 AND deleted_at IS NULL
           AND ($1 = 'all' OR organization_id = $2 AND (
               $1 = 'organization'
               OR $1 = 'self' AND owner_user_id = $3
               OR $1 = 'department' AND department_id = $4
               OR $1 = 'department_and_children'
                  AND department_id IN (SELECT id FROM visible_departments)
           ))"
    )))
    .bind(actor.data_scope.as_str())
    .bind(actor.organization_id)
    .bind(actor.user_id)
    .bind(actor.department_id)
    .bind(id)
    .fetch_optional(pool)
    .await
}

pub async fn list(
    pool: &PgPool,
    actor: &ActorContext,
    page: i64,
    page_size: i64,
) -> Result<Vec<{{ENTITY_NAME}}Row>, sqlx::Error> {
    sqlx::query_as::<_, {{ENTITY_NAME}}Row>(AssertSqlSafe(format!(
        "WITH RECURSIVE visible_departments AS (
             SELECT id FROM departments WHERE id = $4 AND organization_id = $2
             UNION
             SELECT child.id FROM departments child
             JOIN visible_departments parent ON child.parent_id = parent.id
             WHERE child.organization_id = $2
         )
         SELECT {ENTITY_COLUMNS} FROM {{TABLE_NAME}}
         WHERE deleted_at IS NULL
           AND ($1 = 'all' OR organization_id = $2 AND (
               $1 = 'organization'
               OR $1 = 'self' AND owner_user_id = $3
               OR $1 = 'department' AND department_id = $4
               OR $1 = 'department_and_children'
                  AND department_id IN (SELECT id FROM visible_departments)
           ))
         ORDER BY id LIMIT $5 OFFSET $6"
    )))
    .bind(actor.data_scope.as_str())
    .bind(actor.organization_id)
    .bind(actor.user_id)
    .bind(actor.department_id)
    .bind(page_size)
    .bind((page - 1) * page_size)
    .fetch_all(pool)
    .await
}

pub async fn count(pool: &PgPool, actor: &ActorContext) -> Result<i64, sqlx::Error> {
    let row = sqlx::query(
        "WITH RECURSIVE visible_departments AS (
             SELECT id FROM departments WHERE id = $4 AND organization_id = $2
             UNION
             SELECT child.id FROM departments child
             JOIN visible_departments parent ON child.parent_id = parent.id
             WHERE child.organization_id = $2
         )
         SELECT count(*) FROM {{TABLE_NAME}}
         WHERE deleted_at IS NULL
           AND ($1 = 'all' OR organization_id = $2 AND (
               $1 = 'organization'
               OR $1 = 'self' AND owner_user_id = $3
               OR $1 = 'department' AND department_id = $4
               OR $1 = 'department_and_children'
                  AND department_id IN (SELECT id FROM visible_departments)
           ))",
    )
    .bind(actor.data_scope.as_str())
    .bind(actor.organization_id)
    .bind(actor.user_id)
    .bind(actor.department_id)
    .fetch_one(pool)
    .await?;
    row.try_get::<i64, _>(0)
}

