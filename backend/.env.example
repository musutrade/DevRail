DATABASE_URL="postgres://arc_admin:change-me@localhost:5432/arc_admin"
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=1
DB_ACQUIRE_TIMEOUT_SECS=5
DB_CONNECT_TIMEOUT_SECS=10
DB_IDLE_TIMEOUT_SECS=600
DB_MAX_LIFETIME_SECS=1800
DB_STATEMENT_TIMEOUT_MS=30000
AUTO_MIGRATE=true
PORT=8080
APP_ENV=development
SESSION_TTL_SECS=28800
SESSION_IDLE_TIMEOUT_SECS=1800
PERSISTENT_SESSION_TTL_SECS=2592000
PERSISTENT_SESSION_IDLE_TIMEOUT_SECS=604800
MAX_SESSIONS_PER_USER=10
LOGIN_MAX_FAILURES=5
LOGIN_IP_MAX_FAILURES=50
LOGIN_ACCOUNT_IP_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECS=900
LOGIN_LOCKOUT_SECS=900
# Only list reverse proxy/LB networks you operate. Leave empty for direct access.
TRUSTED_PROXY_CIDRS=
CORS_ALLOWED_ORIGINS=http://localhost:4200
LOG_FORMAT=pretty
RUST_LOG=info,tower_http=info,sqlx=warn
SERVICE_NAME=arc-admin-backend
# Production must inject a random base64-encoded 32-byte key from a secret manager.
MFA_ENCRYPTION_KEY=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:4200
WEBAUTHN_RP_NAME="Arc Admin"
AUDIT_RETENTION_DAYS=365
AUDIT_ARCHIVE_BATCH_SIZE=10000
AUDIT_ARCHIVE_DIR=audit-archives
# Empty disables OTLP tracing. Use the local Tempo HTTP receiver when enabled.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.10

# DevRail Harness 与 Symphony 调度策略。
DEVRAIL_HARNESS_COMMAND=codex
DEVRAIL_HARNESS_MAX_CONCURRENCY=2
DEVRAIL_RUN_MAX_DURATION_SECS=3600
DEVRAIL_RUN_WORKSPACE_ROOT=/tmp/devrail-workspaces
DEVRAIL_RUN_GRACEFUL_INTERRUPT_SECS=10
DEVRAIL_SCHEDULER_POLL_SECS=10
DEVRAIL_SCHEDULER_CLAIM_LEASE_SECS=60
DEVRAIL_SCHEDULER_RETRY_BASE_SECS=1
DEVRAIL_SCHEDULER_RETRY_MAX_SECS=300
DEVRAIL_SCHEDULER_RETRY_JITTER_PERCENT=20
DEVRAIL_SCHEDULER_STALL_SECS=120
DEVRAIL_SCHEDULER_PRIORITY_AGING_SECS=3600
DEVRAIL_WORKFLOW_RELOAD_SECS=15
DEVRAIL_WORKFLOW_RELOAD_JITTER_PERCENT=20

# Optional metadata used only by `cargo run --bin bootstrap_admin`.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator
